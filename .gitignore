# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# OpenNext Cloudflare 构建产物（push 由 CI 构建生成）
/.open-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright mcp
.playwright-mcp/

# workbuddy 项目记忆（本地工具数据，不进版本库）
.workbuddy/

# PWA 构建产物（构建时由 next-pwa 自动生成到 public/）
/public/sw.js
/public/workbox-*.js
/public/swe-worker-*.js

# 运行时日志（本地启动产生的 .log 文件，不进版本库）
/data/
