# =========================================================
# 神族九帝 短视频解析站 - 环境变量示例
# 用法：复制本文件为 .env 后按需填写；所有变量均可选（不配即有默认/自动禁用）。
# =========================================================

# ---- 抖音（提升解析成功率）----
# DOUYIN_COOKIE=your_cookie
# DOUYIN_USER_AGENT=your_user_agent

# ---- 哔哩哔哩 ----
# BILIBILI_USER_AGENT=your_user_agent

# ---- 微博（已改为自动游客模式，无需配置 Cookie）----
# WEIBO_COOKIE=your_cookie

# ---- 解析行为统计（Turso/libsql；未配置时记录功能自动禁用）----
# TURSO_DB_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_token
# STATS_API_KEY=your_stats_key

# ---- 视频解析入口开关（/api/config 读取；值需为 "true" 才放开，默认关闭）----
# VIDEO_PARSE_ENABLED=true

# =========================================================
# floating-unlock 广告解锁配额（登录用户免费 N 次后看广告）
# 默认开启：src/config/floating-unlock.ts 的 enableGate: true，无需配置任何变量。
# 仅在需要临时覆盖时才设置（环境变量优先于配置文件）：
#   1 / true  -> 强制开启
#   0 / false -> 强制关闭（线上快速回退用，不用改代码、重启即生效）
# 验票与建票后端地址如需覆盖也可用 FLOATING_UNLOCK_API_BASE（默认 https://wx-auth.shenzjd.com）
# =========================================================
# FLOATING_UNLOCK_GATE=0
# FLOATING_UNLOCK_API_BASE=https://wx-auth.shenzjd.com
